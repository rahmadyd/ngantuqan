{
  "name": "ngantuqan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:validation": "node --experimental-strip-types scripts/check-contact-validation.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:auth": "node scripts/check-admin-auth.mjs",
    "check:admin": "node scripts/check-admin-sections.mjs",
    "check:crud": "node scripts/check-admin-crud.mjs",
    "check:order": "node scripts/check-order-flow.mjs",
    "check:email": "node --experimental-strip-types scripts/check-email-templates.mjs",
    "check:checkout": "node scripts/check-checkout-flow.mjs",
    "check:ratelimit": "node scripts/check-rate-limit.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "check:stripe": "node scripts/check-stripe.mjs",
    "check:content": "node scripts/check-content-flow.mjs",
    "generate:demo-art": "node scripts/generate-demo-art.mjs",
    "gen:types": "node scripts/generate-types.mjs",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "resend": "6.38.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "playwright": "1.65.0",
    "rclone.js": "^0.6.6",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.160.1"
  }
}
