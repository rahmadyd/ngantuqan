# -----------------------------------------------------------------------------
# ngantuqan — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# -----------------------------------------------------------------------------

# Public site URL. Used for metadataBase, canonical URLs, sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server-only). NEVER prefix with NEXT_PUBLIC_.
# Used for: signed download URLs, privileged storage writes.
SUPABASE_SECRET_KEY=

# Signs the order access tokens used by guest checkout (conflict C3).
# Server-only. Falls back to SUPABASE_SECRET_KEY when it is not set.
ORDER_ACCESS_SECRET=

# Storage bucket holding public preview images (project covers, product previews).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=public-media

# Resend — transactional email. Leave blank to run without email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Studio <hello@ngantuqan.studio>

# Studio defaults. The database (site_settings) wins once configured;
# these are fallbacks for first boot and email headers.
STUDIO_NAME=ngantuqan
STUDIO_EMAIL=hello@ngantuqan.studio

# Payment provider. "manual" is the default: the customer transfers the
# money and the studio confirms it in the admin panel. "stripe" sends the
# customer to Stripe's checkout page and marks the order paid from Stripe's
# signed callback.
PAYMENT_PROVIDER=manual

# Stripe — only needed when PAYMENT_PROVIDER is "stripe".
# The secret key is server-only; the webhook secret signs the callbacks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting for public forms.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Optional. Signs the hashed client address stored with the rate limit
# counters. Falls back to ORDER_ACCESS_SECRET, then SUPABASE_SECRET_KEY.
RATE_LIMIT_SECRET=

# Admin email permitted to access /admin (comma-separated for multiple).
ADMIN_EMAIL=
